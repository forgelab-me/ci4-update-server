# The application lives in src/; the repository root holds packaging and docs.

/src/vendor/
/src/build/
/src/.phpunit.cache/

# Environment — never commit real secrets, only the .example files are tracked.
# Two of them, deliberately: /.env configures Compose, /src/.env configures
# CodeIgniter. Keeping them in separate directories is what stops one from
# overwriting the other.
/.env
/.env.*
!/.env.example
/src/.env
/src/.env.*
!/src/.env.example

# Previous dependency trees parked by a swapped-root update (ci4-updater 2.7)
/src/.updater-swap/

# Local Compose override (build from source instead of pulling the image)
/compose.override.yaml

# Writable — runtime data, keep the directory structure only
/src/writable/backups/*
/src/writable/cache/*
/src/writable/debugbar/*
/src/writable/keys/*
/src/writable/logs/*
/src/writable/session/*
/src/writable/tmp/*
/src/writable/uploads/*
!/src/writable/**/index.html

# Build artifacts (generated by update:manifest, which runs from src/)
/src/manifest.json
/src/manifest.json.sig
/src/release_*.zip

# Local SQLite databases
*.db
