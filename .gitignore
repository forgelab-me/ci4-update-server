/vendor/
/build/
/.phpunit.cache/

# Environment — never commit real secrets, only .env.example is tracked
/.env
/.env.*
!/.env.example

# Writable — runtime data, keep the directory structure only
/writable/backups/*
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/tmp/*
/writable/uploads/*
!/writable/**/index.html

# Build artifacts (generated by update:manifest)
/manifest.json
/release_*.zip

# Local SQLite databases
*.db
